# Add these in Netlify's Environment variables settings.
# Browser settings: use the Supabase publishable/anon key, never a secret key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-key

# Server-only Supabase settings. Use the same project as above.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Production transactional email through Resend.
EMAIL_PROVIDER=resend
ADMIN_EMAIL=your-notification-inbox@gmail.com
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Nyanchiew Malual <bookings@your-verified-domain.com>

# Optional mailbox alternative (requires OAuth setup before use).
# EMAIL_PROVIDER=gmail
# MAILBOX_EMAIL=your-sending-mailbox@gmail.com
# MAILBOX_NAME=Nyanchiew Malual
# MAILBOX_CLIENT_ID=your-oauth-client-id
# MAILBOX_CLIENT_SECRET=your-oauth-client-secret
# MAILBOX_REFRESH_TOKEN=your-oauth-refresh-token
# EMAIL_PROVIDER=outlook
# MAILBOX_EMAIL=your-sending-mailbox@outlook.com
# MAILBOX_TENANT_ID=common
